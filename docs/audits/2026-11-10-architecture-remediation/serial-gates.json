[
  {
    "gate": "workspace-doctests",
    "command": [
      "cargo",
      "test",
      "--doc",
      "--workspace",
      "--all-features",
      "--locked"
    ],
    "returncode": 0
  },
  {
    "gate": "official-consumer",
    "command": [
      "cargo",
      "test",
      "--manifest-path",
      "integration/egui-official-harness/Cargo.toml",
      "--locked",
      "--target-dir",
      "target"
    ],
    "returncode": 0
  },
  {
    "gate": "official-caller-owned",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--manifest-path",
      "integration/egui-official-harness/Cargo.toml",
      "--features",
      "demo",
      "--bin",
      "official-caller-owned-demo",
      "--locked",
      "--target-dir",
      "target",
      "--test-threads=1",
      "--no-fail-fast",
      "--status-level",
      "fail",
      "--final-status-level",
      "fail"
    ],
    "returncode": 0
  },
  {
    "gate": "product-default",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--manifest-path",
      "integration/egui-product-harness/Cargo.toml",
      "--all-targets",
      "--locked",
      "--target-dir",
      "target",
      "--test-threads=1",
      "--no-fail-fast",
      "--status-level",
      "fail",
      "--final-status-level",
      "fail"
    ],
    "returncode": 0
  },
  {
    "gate": "product-serde",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--manifest-path",
      "integration/egui-product-harness/Cargo.toml",
      "--features",
      "serde",
      "--all-targets",
      "--locked",
      "--target-dir",
      "target",
      "--test-threads=1",
      "--no-fail-fast",
      "--status-level",
      "fail",
      "--final-status-level",
      "fail"
    ],
    "returncode": 0
  },
  {
    "gate": "host-default",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--manifest-path",
      "integration/dockspace-host-harness/Cargo.toml",
      "--all-targets",
      "--locked",
      "--target-dir",
      "target",
      "--test-threads=1",
      "--no-fail-fast",
      "--status-level",
      "fail",
      "--final-status-level",
      "fail"
    ],
    "returncode": 0
  },
  {
    "gate": "core-dependencies",
    "command": [
      "python3",
      "scripts/check_core_dependencies.py"
    ],
    "returncode": 0
  }
]
